Options -Indexes
ServerSignature Off

RewriteEngine On

# VPR HTTPS-ONLY:
# Any plain HTTP request is permanently upgraded to HTTPS on the same domain.
# This remains valid if the whole site is moved to a new domain.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^(?:tests|bin|Documentation)(?:/|$) - [F,L,NC]

# Block web access to private storage and common secret/backup files.
RewriteRule ^data(?:/|$) - [F,L,NC]
RewriteRule "(^|/)\." - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self' https://www.paynow.co.zw; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

<FilesMatch "^(admin2000|recover_admin|repair_payment_db|data_exchange|traffic_report)\.php$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </IfModule>
</FilesMatch>

<FilesMatch "^(config\.php|db\.php|payments\.php|paynow_profiles\.php|express_checkout\.php|composer\.(json|lock)|.*\.(sqlite|sqlite3|db|bak|backup|log|ini|env|sql|sh|pem|key|crt|old|orig))$">
  Require all denied
</FilesMatch>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

LimitRequestBody 26214400

<LimitExcept GET POST HEAD>
  Require all denied
</LimitExcept>
